{
  "name": "yogamaya-ru",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "db:migrate:local": "wrangler d1 migrations apply yogamaya-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply yogamaya-db --remote",
    "db:seed:local": "wrangler d1 execute yogamaya-db --local --file=./migrations/0002_seed.sql",
    "db:seed:remote": "wrangler d1 execute yogamaya-db --remote --file=./migrations/0002_seed.sql",
    "cf:deploy": "wrangler pages deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sveltejs/kit": "^2.16.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "@sveltejs/adapter-cloudflare": "^4.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wrangler": "^3.109.0"
  }
}
